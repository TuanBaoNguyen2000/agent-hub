{
  "name": "agenthub",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run dev --workspace @agenthub/desktop",
    "build": "npm run build --workspace @agenthub/desktop",
    "package": "npm run package --workspace @agenthub/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
