{
  "name": "@agenthub/desktop",
  "productName": "AgentHub",
  "version": "0.0.0",
  "private": true,
  "description": "AgentHub desktop application",
  "author": "AgentHub",
  "main": "out/main/index.js",
  "scripts": {
